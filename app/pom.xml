<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>photos.sluice</groupId>
  <artifactId>sluice</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Sluice</name>
  <description>Cross-platform photo/video organizer</description>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0 only</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>26</java.version>
    <javafx.version>26.0.1</javafx.version>
    <twelvemonkeys.version>3.14.0</twelvemonkeys.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.twelvemonkeys.bom</groupId>
        <artifactId>bom</artifactId>
        <version>${twelvemonkeys.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.drewnoakes</groupId>
      <artifactId>metadata-extractor</artifactId>
      <version>2.20.0</version>
    </dependency>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.50.0</version>
    </dependency>
    <!-- Versions for all com.twelvemonkeys.imageio modules come from the BOM above, imported
         into dependencyManagement - every module here always resolves to the same release. -->
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-tiff</artifactId>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-webp</artifactId>
    </dependency>
    <dependency>
      <groupId>net.coobird</groupId>
      <artifactId>thumbnailator</artifactId>
      <version>0.4.21</version>
    </dependency>
    <dependency>
      <groupId>org.apache.xmlgraphics</groupId>
      <artifactId>batik-transcoder</artifactId>
      <version>1.19</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Only pulled in transitively via spring-boot-starter-test above, but declared explicitly
         so the surefire plugin's ${org.mockito:mockito-core:jar} property (its -javaagent path,
         below) resolves reliably in every tool, not just command-line Maven - the IDE's own
         indexing needs the coordinate listed directly to recognize it. Version comes from Spring
         Boot's own parent BOM, same as the other Spring-managed dependencies above. -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>1.4.2</version>
      <scope>test</scope>
    </dependency>
    <!-- Drives the real window in a test: starts the toolkit, runs work on the FX thread, and
         clicks controls. The OSGi jar it carries is only wanted when running as a bundle, and
         nothing manages its version, so it is excluded rather than left on the test classpath. -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.osgi</groupId>
          <artifactId>org.osgi.core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The native-access flag silences the warning JavaFX raises when it loads its own
               native libraries. A later JDK turns that warning into a hard failure. -->
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <!-- JavaFX's own headless backend, part of javafx.graphics on every platform since 26.
                 A test that opens a window then needs no display, so CI needs no virtual one and no
                 separate native library to supply it. Set for the test JVM only; the real app still
                 opens a real window. -->
            <glass.platform>headless</glass.platform>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <configuration>
          <!-- Read by prepare-agent too, not only report/check: this list controls which classes
               the javaagent instruments, not only which ones a rule counts. A class excluded here
               carries no probes at all, so no check execution can ever measure it, whatever that
               execution's own includes or excludes say. That is why the view package is not named
               here even though the bundle-wide rule below excludes it from ITS OWN ratio - view
               needs real instrumentation for check-view's own rule to have anything to read. -->
          <excludes>
            <!-- The application's bootstrap entry point: it locates the config file and hands the
                 launch on, with nothing to unit-test. Standard exclusion for this kind of class. -->
            <exclude>photos/sluice/SluiceApplication.class</exclude>
            <!-- The native credential-store bindings, one per platform. A binding only runs on the
                 platform whose library it binds, so no single leg of the matrix can cover one and
                 the gate would measure the matrix rather than the tests. Excluded on the same terms
                 as the views above: it stays honest only while a binding carries bytes and decides
                 nothing. What to store, what a refusal means and which platform to reach for all
                 live in the tier and the selector, inside the gate. A binding's own proof is its
                 round-trip test against the real credential store. -->
            <exclude>photos/sluice/adapter/secrets/Advapi32CredentialManager.class</exclude>
            <!-- One deliberate exception to "decides nothing", named rather than glossed over.
                 LibsecretService.write rules that a store reporting neither success nor an error
                 is a failure. That ruling has to sit here, because the silence it reads is a
                 property of the native call and does not survive the seam. Every other decision
                 stays in the tier. -->
            <exclude>photos/sluice/adapter/secrets/LibsecretService.class</exclude>
            <!-- The second such exception, and the same shape as the one above. The macOS binding
                 rules that an entry the keychain matched and then produced no bytes for is a
                 failure. That ruling has to sit here, because the pairing of a status code with an
                 empty result is a property of the native call and does not survive the seam.
                 The second line is for this binding's nested types, which compile to their own
                 class files and so are not covered by the first. It is the only binding with any.
                 The gate stays green without it, since the rule below measures the whole bundle and
                 absorbs two small classes. Kept anyway: they are exactly as uncoverable off macOS
                 as their enclosing class, and leaving them in would dilute the ratio rather than
                 be excluded by it. -->
            <exclude>photos/sluice/adapter/secrets/SecurityFrameworkKeychain.class</exclude>
            <exclude>photos/sluice/adapter/secrets/SecurityFrameworkKeychain$*.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>test</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <!-- The JavaFX classes themselves. Logic lives in presenters one package up,
                       which stay inside this rule; what is left here constructs controls and binds
                       them. Driving all of that through the toolkit to 95% instruction coverage
                       would buy a slower, more brittle suite and no more confidence, and
                       check-view holds its own, lower floor instead. A rule-level exclude rather
                       than the plugin-level one above: the classes still need real instrumentation
                       for that other rule to read. -->
                  <excludes>
                    <exclude>photos.sluice.adapter.ui.view.*</exclude>
                  </excludes>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.95</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
          <!-- A regression floor for the views the rule above excludes, on the two
               numbers a pane cannot inflate for free. Instruction and line execute just by being
               constructed, whether or not a test ever drives what a control does. Branch coverage
               carries no minimum: the native DirectoryChooser dialog no headless harness can reach
               drags that number down by a fixed, unmovable amount, so a threshold meant to mean
               something would force testing what cannot be tested, and one loose enough to pass
               would catch nothing. The limits below sit a few points under what the package
               measured at when this gate was set, a floor rather than that number restated. -->
          <execution>
            <id>check-view</id>
            <phase>test</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <!-- A BUNDLE-element rule ignores its own includes/excludes - those only apply to a
                   PACKAGE or CLASS element - so scoping has to happen here instead, at the class
                   file selection JaCoCo actually analyses. Confirmed by watching a rule-level
                   include silently pass at an unreachable 0.99 threshold: the rule was evaluating
                   the whole 317-class bundle, not the 13-class view package it named. -->
              <includes>
                <include>photos/sluice/adapter/ui/view/**</include>
              </includes>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
